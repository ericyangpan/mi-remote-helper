    "Pair the remote in Bluetooth settings. Choose the same virtual microphone in this app and your input method, then select the matching voice shortcut.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair the remote in Bluetooth settings. Choose the same virtual microphone in this app and your input method, then select the matching voice shortcut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在蓝牙设置中配对遥控器。在本应用与输入法中选择同一个虚拟麦克风，并设置匹配的语音快捷键。"
          }
        }
      }
    },
