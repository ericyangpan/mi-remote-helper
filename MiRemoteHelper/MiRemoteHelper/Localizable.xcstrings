    "Hold for 0.5 seconds for a long press. When a double-press action is assigned, short presses wait 0.3 seconds for a second press. Voice input stays fixed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold for 0.5 seconds for a long press. When a double-press action is assigned, short presses wait 0.3 seconds for a second press. Voice input stays fixed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按阈值为 0.5 秒。设有双击动作时，短按会等待 0.3 秒以识别第二次按下。语音输入保持固定。"
          }
        }
      }
    },
    "This replaces all Global short-press, double-press and long-press mappings. App mappings stay unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces all Global short-press, double-press and long-press mappings. App mappings stay unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会替换全部全局短按、双击和长按映射。应用专属映射保持不变。"
          }
        }
      }
    },
    "In the app switcher, use Left/Right to choose, OK or Home to confirm, and Back to cancel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the app switcher, use Left/Right to choose, OK or Home to confirm, and Back to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用切换器中，左右键选择，OK 或 Home 确认，Back 取消。"
          }
        }
      }
    },
    "%.1f s": {
      "localizations": {
